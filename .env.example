# AARAMBHA Platform Environment Configuration Example
# Server Port
PORT=5000

# Client API Base URL
VITE_API_URL=http://localhost:5000/api/v1

# Database Configuration (Optional MongoDB Atlas connection; fallback local data is active if not set)
MONGODB_URI=your_mongodb_atlas_connection_string

# AI Provider API Keys (Used only on server side; never exposed to browser)
OPENAI_API_KEY=your_openai_api_key
GEMINI_API_KEY=your_gemini_api_key

# Optional Supabase Configuration
# VITE_SUPABASE_URL=your_supabase_project_url
# VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
